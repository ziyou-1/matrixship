# Video breakdown: non-secret runtime settings.
MATRIX_CENTRAL=http://127.0.0.1:9080
MATRIX_AGENT_DATA_DIR=backend/datas
DY_DATA_DIR=backend/datas

# Matrix -> AI CanvasPro short-lived SSO. Generate one random secret (at least
# 32 bytes) and configure the same value on the central server and AI CanvasPro.
MATRIX_COMIC_SSO_ENABLED=0
MATRIX_COMIC_SSO_SECRET=
MATRIX_COMIC_SSO_ISSUER=matrix-central
MATRIX_COMIC_SSO_AUDIENCE=aicanvas
MATRIX_COMIC_SSO_TTL_SEC=60
# Same-style replacement writes every comic-project task into the shared
# AI CanvasPro account 003. The password is never stored in Matrix config.
MATRIX_COMIC_FIXED_USER_ID=44
MATRIX_COMIC_FIXED_USERNAME=003
MATRIX_COMIC_FIXED_DISPLAY_NAME=003
# Public AI CanvasPro origin used by the desktop comic-project adapter.
MATRIX_COMIC_BASE_URL=http://120.26.194.174

# MiniMax official direct video generation for the central server.
# Keep the service key in the environment only; never expose it to clients.
MINIMAX_ENABLED=1
MINIMAX_CENTER_API_BASE=https://api.minimaxi.com
MINIMAX_CENTER_API_KEY=
MINIMAX_COMIC_API_BASE=https://api.minimaxi.com
MINIMAX_COMIC_API_KEY=
MINIMAX_MAX_ACTIVE_TASKS=2
MINIMAX_TASK_TIMEOUT_SEC=900
MINIMAX_POLL_INTERVAL_SEC=5

VIDEO_OCR_LANG=chi_sim+eng
VIDEO_OCR_CONFIG=--oem 3 --psm 11
TESSERACT_CMD=
VIDEO_TRANSCRIBE_MODEL=gemini-3.1-pro-preview
VIDEO_TRANSCRIBE_CHUNK_SEC=60
# Leave blank to transcribe the complete source video. Set a positive value
# only when the deployment intentionally needs a hard upper bound.
VIDEO_TRANSCRIBE_MAX_SEC=
VIDEO_TRANSCRIBE_TIMEOUT_SEC=180
VIDEO_TRANSCRIBE_RETRIES=2
VIDEO_BREAKDOWN_MAX_CONCURRENCY=1
VIDEO_BREAKDOWN_TEMP_RETENTION_SEC=3600
MEDIA_QUARANTINE_RETENTION_DAYS=7
# Leave blank to use the duration-aware decode budget for the complete video.
MEDIA_DECODE_TIMEOUT_SEC=
DOUYIN_MEDIA_TIMEOUT_SEC=180

# Legal agreement versions. Increment a version to require consent again.
LEGAL_TERMS_VERSION=1.0
LEGAL_PRIVACY_VERSION=1.0
LEGAL_EFFECTIVE_DATE=2026-07-15

# Hybrid video replacement V2. Keep secrets and licensed model files outside source control.
VIDEO_REPLACE_PIPELINE=hybrid_v2
VIDEO_REPLACE_MAX_DURATION_SEC=60
VIDEO_REPLACE_FACE_RETENTION_SEC=86400
VIDEO_REPLACE_VISUAL_QC=1
VIDEO_REPLACE_REFERENCE_MAX_BYTES=20971520
VIDEO_REPLACE_STRICT_SCRIPT_AUDIO=0
# Single-protagonist source-video editing. Set to 0 for an emergency rollback
# to the legacy reference-to-video route. No credentials are stored here.
VIDEO_REPLACE_PRINCIPAL_REPLACEMENT=1
VIDEO_REPLACE_PRINCIPAL_MODEL=happyhorse-video-edit
VIDEO_REPLACE_PRINCIPAL_MIN_CONFIDENCE=0.65
VIDEO_REPLACE_PRODUCT_PARALLEL=2
LK888_IMAGE_TIMEOUT_SEC=540
LK888_SYNC_IMAGE_TIMEOUT_SEC=480
FACEFUSION_BIN=
FACEFUSION_MODEL_DIR=
FACEFUSION_LICENSE_REF=
FACEFUSION_EXECUTION_PROVIDER=coreml,cpu

# Optional LK888 egress proxy for local networks that cannot complete TLS to api.lk888.ai.
# The proxy must forward Authorization to LK888 and must not inject or log secrets.
LK888_BASE_URL=https://img.yunlingai.net/lk888-upstream

# Public upload service for LK888-readable image/video references.
# Do not commit a real token. Put UPLOAD_TOKEN only in backend/.env or process env.
UPLOAD_API_URL=https://img.yunlingai.net/api/upload
PUBLIC_UPLOAD_BASE_URL=https://img.yunlingai.net/uploads
PUBLIC_IMAGE_BASE_URL=https://img.yunlingai.net/uploads
UPLOAD_TOKEN=

# Xiaohongshu lead collection quality gate. Set to 0 only for emergency rollback.
XHS_STRICT_LEAD_FILTER_ENABLED=1

# Xiaohongshu platform availability. Shipped on by default so 图文同款 and the
# rest of the XHS surface work in the public package. Set to 0 to fall back to
# the Douyin-only surface; that requires restarting the native client, the local
# executor and the central server together.
MATRIX_XHS_ENABLED=1

# Native-client feature visibility. 同款替换 ships on by default; set a flag to 0
# and restart the client to hide the corresponding surface again.
MATRIX_VIDEO_REPLACEMENT_ENABLED=1
MATRIX_PENDING_PUBLISH_UI_ENABLED=0
MATRIX_DIGITAL_HUMAN_TTS_UPLOAD_ENABLED=0
